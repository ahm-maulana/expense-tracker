{
	"name": "expense-tracker",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"prettier": "^3.7.4",
		"turbo": "^2.10.5",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "11.7.0"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
