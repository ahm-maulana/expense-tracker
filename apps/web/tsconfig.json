{
	"extends": "@repo/typescript-config/nextjs.json",
	"compilerOptions": {
		"strictNullChecks": true,
		"resolvePackageJsonImports": true,
		"paths": {
			"@/*": ["./src/*"],
			"@/app/*": ["./app/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"next-env.d.ts",
		"next.config.js",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
